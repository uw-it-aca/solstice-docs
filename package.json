    "solstice-theme": "github:uw-it-aca/solstice-theme#1.0.6",
    "solstice-vue": "github:uw-it-aca/solstice-vue#1.1.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4",
    "vue3-mq": "^4.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.2",
